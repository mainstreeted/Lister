# Copy to .env and fill in. NEVER commit .env.
# Lister loads this automatically via python-dotenv.

# --- LLM (required for ranking + tailoring) ---
ANTHROPIC_API_KEY=

# --- Site credentials (only needed for sites that require login) ---
# Used by Playwright to bootstrap a persistent profile the first time.
# After first login, the cookie/session is reused from .browser-profiles/.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

INDEED_EMAIL=
INDEED_PASSWORD=

ZIPRECRUITER_EMAIL=
ZIPRECRUITER_PASSWORD=

# --- Gmail (for the email_digest connector) ---
# Use a Gmail app password, not your regular password.
# Set up: myaccount.google.com → Security → 2-Step Verification → App passwords.
# IMAP must be enabled: Gmail → Settings → Forwarding and POP/IMAP → Enable IMAP.
GMAIL_USER=
GMAIL_PASSWORD=

# --- Optional notification of daily run output ---
# Leave blank to just print to stdout / log file.
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
